# Игнорировать все файлы и директории
*

# Но не игнорировать Python файлы
!*.py

# Не игнорировать текстовые файлы
!*.txt

# Не игнорировать файлы базы данных
!*.db

# Не игнорировать сам .gitignore
!.gitignore

# Игнорировать __pycache__ и .pyc файлы
__pycache__/
*.py[cod]
*$py.class

# Игнорировать виртуальные окружения
venv/
env/
ENV/

# Игнорировать IDE файлы
.idea/
.vscode/
*.swp
*.swo

# Игнорировать тестовые директории
test_dir*/
test_monitor/

# Игнорировать временные файлы
*.tmp
*.log

# Игнорировать markdown файлы
*.md
